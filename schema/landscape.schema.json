{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maryamtahhan.github.io/evalscape/schema/landscape.schema.json",
  "title": "Evalscape Landscape",
  "type": "object",
  "required": ["categories", "tools"],
  "additionalProperties": false,
  "properties": {
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "required": ["id", "name", "description", "color"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "colorDark": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "tool": {
      "type": "object",
      "required": [
        "id", "name", "shortName", "initials", "description",
        "category", "hardware", "types", "url"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "initials": { "type": "string", "minLength": 1, "maxLength": 4 },
        "logo": { "type": "string" },
        "stars": { "type": "integer", "minimum": 0 },
        "forks": { "type": "integer", "minimum": 0 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "hardware": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["cpu", "gpu"] },
          "uniqueItems": true
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "online", "offline", "quality", "code", "agent",
              "rag", "embedding", "audio", "safety", "multimodal", "security"
            ]
          },
          "uniqueItems": true
        },
        "url": { "type": "string", "minLength": 1 },
        "docs": { "type": "string", "format": "uri" },
        "paper": { "type": "string", "format": "uri" },
        "huggingface": { "type": "string", "format": "uri" },
        "license": { "type": "string" },
        "org": { "type": "string" },
        "metrics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "enum": ["active", "experimental", "archived"]
        },
        "lastReviewed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "useCases": {
          "type": "array",
          "items": {
            "enum": [
              "pre-production", "ci-friendly", "leaderboard",
              "production-monitoring", "research", "api-benchmarking", "cost-analysis"
            ]
          },
          "uniqueItems": true
        },
        "related": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    }
  }
}
